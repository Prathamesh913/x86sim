# x86Code .gitignore: nothing from Apple (runtime, SDK, frameworks), no device data, no build outputs, no secrets.

# local configuration and runtime state
/x86sim.env
/var/
/spike3/
# Apple runtime / SDK / frameworks and reference material (kept locally only)
/runtimes/
/RuntimeRoot
/hostfw/
/research/
/analysis/
/patches/
# Darling install prefix and the compat symlink to external/darling
/darling-prefix/
/darling
/third_party/
# build outputs
target/
__pycache__/
*.pyc
*.dylib
*.dylib.new
*.new
*.framework/
*.core
core.[0-9]*
/tests/metal/shaders/probe.air
/tests/metal/shaders/probe.ll
/tests/metal/shaders/probe.metallib
# Mach-O binaries built on the Mac (build/mac-build-*.sh); see README "Simulator-side binaries"
/host/fpsim2host/fpsim2host
/host/fseventsd/fseventsd
/host/iosurfaced/iosurfaced
/host/metalhostd/metalhostd
/host/netconfig/netconfig
/host/openurl/openurl
/host/debugserver/debugserver
/host/simhost/simhost
/tests/iosurface/iosprobe
/tests/metal/mtlprobe
/tests/probes/bulkprobe
